# ============================================================
# VAYORA — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- PostgreSQL / PostGIS ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vayora
POSTGRES_USER=vayora_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- Spring Boot ----
SPRING_PORT=8080
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHAR_RANDOM_SECRET_KEY_FOR_HS512_ALGORITHM
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000
SPRING_PROFILES_ACTIVE=dev

# ---- FastAPI (AI Service) ----
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=ai-service
AI_LOG_LEVEL=info

# ---- Node.js Realtime Gateway ----
REALTIME_PORT=3001
REALTIME_HOST=realtime-gateway

# ---- Frontend ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_BASE_URL=http://localhost:8000
VITE_REALTIME_URL=http://localhost:3001

# ---- OSRM ----
OSRM_HOST=osrm
OSRM_PORT=5000
OSRM_BASE_URL=http://osrm:5000

# ---- Docker Compose ----
COMPOSE_PROJECT_NAME=vayora

# ---- Research / Simulation ----
SIMULATION_SEED=42
SIMULATION_ENABLED=true

# ---- Security ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ---- Observability ----
LOG_LEVEL=INFO
